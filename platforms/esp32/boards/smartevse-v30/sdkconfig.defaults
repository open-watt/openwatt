# SmartEVSE v3.0 has 4 MB flash and no PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_SPIRAM=n

# Keep actionable IDF diagnostics without its runtime tag database or
# duplicate timestamps; OpenWatt timestamps and filters the captured records.
CONFIG_LOG_VERSION_2=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
CONFIG_LOG_DYNAMIC_LEVEL_CONTROL=n
CONFIG_LOG_TAG_LEVEL_IMPL_NONE=y
CONFIG_LOG_COLORS=n
CONFIG_LOG_COLORS_SUPPORT=n
CONFIG_LOG_TIMESTAMP_SOURCE_NONE=y
CONFIG_LOG_TIMESTAMP_SUPPORT=n
