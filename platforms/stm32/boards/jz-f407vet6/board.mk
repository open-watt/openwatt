# JZ-F407VET6 industrial board: APM32F407VET6 or STM32F407VET6, 25 MHz HSE, RMII Ethernet,
# RS232 on USART1, RS485 on USART2, CAN1/CAN2, W25Q64, AT24C02. DFU through the BOOT0 jumper.
BOARD_PLATFORM := stm32f4
BOARD_FLASH_SIZE := 512KB
BOARD_PSRAM_SIZE := 0MB
STM32_PART := f407ve
STM32_HSE_HZ := 25000000
TINY ?= 1
FEATURES ?= switch
